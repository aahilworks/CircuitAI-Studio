# Firebase client (public — safe to expose in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only — never expose)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini (server only — never expose)
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=

# Razorpay TEST mode (server only except NEXT_PUBLIC_RAZORPAY_KEY_ID)
# Create plans in Razorpay Dashboard with Test Mode ON → Subscriptions → Plans
# Create separate plans for each currency
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
RAZORPAY_PLAN_ID_INR=plan_test_inr_monthly
RAZORPAY_PLAN_ID_INR_YEARLY=plan_test_inr_yearly
RAZORPAY_PLAN_ID_USD=plan_test_usd_monthly
RAZORPAY_PLAN_ID_USD_YEARLY=plan_test_usd_yearly
RAZORPAY_PLAN_ID_GBP=plan_test_gbp_monthly
RAZORPAY_PLAN_ID_GBP_YEARLY=plan_test_gbp_yearly
RAZORPAY_PLAN_ID_EUR=plan_test_eur_monthly
RAZORPAY_PLAN_ID_EUR_YEARLY=plan_test_eur_yearly
RAZORPAY_PLAN_ID_CAD=plan_test_cad_monthly
RAZORPAY_PLAN_ID_CAD_YEARLY=plan_test_cad_yearly
RAZORPAY_PLAN_ID_AUD=plan_test_aud_monthly
RAZORPAY_PLAN_ID_AUD_YEARLY=plan_test_aud_yearly
RAZORPAY_PLAN_ID_DKK=plan_test_dkk_monthly
RAZORPAY_PLAN_ID_DKK_YEARLY=plan_test_dkk_yearly
RAZORPAY_PLAN_ID_AED=plan_test_aed_monthly
RAZORPAY_PLAN_ID_AED_YEARLY=plan_test_aed_yearly
# Coming soon currencies (add plan IDs when Razorpay supports these)
# RAZORPAY_PLAN_ID_SGD=plan_test_sgd_monthly
# RAZORPAY_PLAN_ID_SGD_YEARLY=plan_test_sgd_yearly
# RAZORPAY_PLAN_ID_CNY=plan_test_cny_monthly
# RAZORPAY_PLAN_ID_CNY_YEARLY=plan_test_cny_yearly
# RAZORPAY_PLAN_ID_CHF=plan_test_chf_monthly
# RAZORPAY_PLAN_ID_CHF_YEARLY=plan_test_chf_yearly
# RAZORPAY_PLAN_ID_SEK=plan_test_sek_monthly
# RAZORPAY_PLAN_ID_SEK_YEARLY=plan_test_sek_yearly
RAZORPAY_TRIAL_DAYS=2
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
