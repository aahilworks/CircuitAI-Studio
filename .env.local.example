# Firebase client (public — safe to expose in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only — never expose)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini (server only — never expose)
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=

# Razorpay TEST mode (server only except NEXT_PUBLIC_RAZORPAY_KEY_ID)
# Create plans in Razorpay Dashboard with Test Mode ON → Subscriptions → Plans
# Monthly: Create subscription plans for each currency
# Yearly: Uses one-time payment (no subscription plan needed)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Monthly Subscription Plans (₹699/month converted to each currency)
RAZORPAY_PLAN_ID_INR=plan_test_inr_monthly
RAZORPAY_PLAN_ID_USD=plan_test_usd_monthly
RAZORPAY_PLAN_ID_GBP=plan_test_gbp_monthly
RAZORPAY_PLAN_ID_EUR=plan_test_eur_monthly
RAZORPAY_PLAN_ID_CAD=plan_test_cad_monthly
RAZORPAY_PLAN_ID_AUD=plan_test_aud_monthly
RAZORPAY_PLAN_ID_DKK=plan_test_dkk_monthly

# Yearly uses one-time payment (no subscription plan needed)
# Amount is calculated dynamically based on currency conversion rates

RAZORPAY_TRIAL_DAYS=2
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
